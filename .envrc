# direnv: devenv's own direnvrc defines `use devenv`; a bare `use devenv`
# fails with "use_devenv: command not found".
eval "$(devenv direnvrc)"
use devenv
# Machine-local values (.env, not committed): loaded by direnv, never by
# devenv's dotenv, which would copy the secrets into the Nix store.
dotenv_if_exists .env
